#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Clock;
use App\Config\ThemeRepository;
use App\Config\UiTextRepository;
use App\Config\UpdatePageRepository;
use App\Domain\LocaleResolver;
use App\Domain\UpdatePageEvaluator;
use App\Http\RequestValidator;
use App\Presentation\HtmlRenderer;
use App\Presentation\TemplateRegistry;

$root = dirname(__DIR__);
require $root . '/vendor/autoload.php';

$game = require $root . '/config/game.php';
$repository = new UpdatePageRepository(
    $game['updatePagesPath'],
    $game['allowedHosts'],
);
$release = $repository->releaseConfig();
$releasePage = $repository->findByTargetVersion($release['releaseTargetVersion']);
if ($releasePage === null) {
    fwrite(STDERR, "PurrfectSpirits release smoke test failed.\n");
    exit(1);
}
$smokeTime = $releasePage['startAt']
    ?? $releasePage['endAt']?->modify('-1 second')
    ?? new DateTimeImmutable('now', new DateTimeZone('UTC'));
$clock = new class($smokeTime) implements Clock {
    public function __construct(private readonly DateTimeImmutable $value)
    {
    }

    public function now(): DateTimeImmutable
    {
        return $this->value;
    }
};
$theme = (new ThemeRepository($game['themePath'], $game['allowedHosts']))->load();
$uiTexts = (new UiTextRepository($game['uiTextsPath']))->load();
$evaluator = new UpdatePageEvaluator($repository, $clock, new LocaleResolver(), $theme, $uiTexts);
$validator = new RequestValidator();
$renderer = new HtmlRenderer(new TemplateRegistry($root . '/templates'));

$destinations = [
    'ios' => 'https://itunes.apple.com/jp/app/id1269423920',
    'android' => 'https://play.google.com/store/apps/details?id=okinawa.harapeco.catRestaurant',
    'pc' => 'https://www.harapeco.okinawa/info/app/neko_boku.html',
];

foreach ($destinations as $platform => $destination) {
    $request = $validator->validate([
        'appVersion' => '0.0.0',
        'targetVersion' => $release['releaseTargetVersion'],
        'locale' => 'en',
        'platform' => $platform,
        'osVersion' => '1',
    ]);
    $viewModel = $evaluator->evaluate($request);
    $html = $renderer->render($viewModel);
    $isReleased = $releasePage['released'][$platform];
    $expectedState = $isReleased ? 'available' : 'unreleased';

    if ($viewModel->state !== $expectedState
        || !$viewModel->showUpdate
        || $viewModel->destinationUrl !== $destination
        || !str_contains($html, 'PurrfectSpirits')
        || str_contains($html, 'A new version is available.')
        || str_contains($html, 'Event period:')
        || str_contains($html, 'Current: V')
        || ($isReleased && !str_contains($html, 'Update and play the event'))
        || ($isReleased && !str_contains($html, htmlspecialchars($destination, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8')))
        || (!$isReleased && !str_contains($html, 'Coming Soon'))
        || (!$isReleased && str_contains($html, '<a class="update-link"'))
        || ($platform !== 'pc' && !$viewModel->showStoreNotice)
        || ($platform === 'pc' && $viewModel->showStoreNotice)
    ) {
        fwrite(STDERR, "PurrfectSpirits release smoke test failed.\n");
        exit(1);
    }
}

fwrite(STDOUT, "PurrfectSpirits release smoke test passed.\n");
