{
    "name": "harapp/app-update-landing",
    "description": "A framework-free PHP application foundation for update landing pages.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "deployer/deployer": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "validate:config": "php scripts/validate-purrfect-spirits.php"
    }
}
