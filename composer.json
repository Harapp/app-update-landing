{
    "name": "harapp/app-update-landing",
    "description": "A framework-free PHP application foundation for update landing pages.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "mobiledetect/mobiledetectlib": "^4.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "deployer/deployer": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "assets:build": "@php bin/build-game-assets purrfect-spirits",
        "validate:config": "@php bin/validate-purrfect-spirits",
        "smoke": "@php bin/smoke-test-purrfect-spirits"
    }
}
